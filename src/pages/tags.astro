---
import BaseLayout from '../layouts/BaseLayout.astro';
import FooterIcons from '../components/FooterIcons.astro';
import { getPosts, tagsIndex } from '../lib/posts';
import { listDate } from '../lib/dates';

const posts = await getPosts();
const tags = tagsIndex(posts);
---

<BaseLayout title="标签">
  <h1 class="sr-only">标签</h1>

  <div class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-2 sm:mt-16" id="tag-filter" role="group" aria-label="按标签筛选">
    <button class="tag-filter-item tag-filter-item--all" type="button" data-tag="*" aria-pressed="true">All</button>
    {
      tags.map((tag) => (
        <button
          class="tag-filter-item"
          type="button"
          data-tag={tag.slug}
          aria-pressed="false"
          style={`--tag: #${tag.color}`}
        >
          {tag.name}
        </button>
      ))
    }
  </div>

  <ol class="mt-6" id="tagged-posts">
    {
      posts.map((post) => (
        <li class="post-item" data-tags={post.tags.map((tag) => tag.slug).join(' ')}>
          <div class="flex items-baseline justify-between gap-6 py-1">
            <a href={post.url} class="text-[15px] leading-6 text-fg transition-colors hover:text-muted">
              {post.title}
            </a>
            <time datetime={post.date} class="shrink-0 text-[13px] text-faint tabular-nums">
              {listDate(post.created)}
            </time>
          </div>
        </li>
      ))
    }
  </ol>

  <FooterIcons />
</BaseLayout>

<script>
  const root = document.getElementById('tag-filter');
  const list = document.getElementById('tagged-posts');

  if (root && list) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('button')];
    const items = [...list.querySelectorAll<HTMLElement>('.post-item')];
    let active = '*';

    const hashTag = () => decodeURIComponent(location.hash.slice(1));

    const apply = () => {
      for (const item of items) {
        const tags = ` ${item.dataset.tags ?? ''} `;
        item.hidden = !(active === '*' || tags.includes(` ${active} `));
      }
    };

    const select = (slug: string, push: boolean) => {
      const next = buttons.some((button) => button.dataset.tag === slug) ? slug : '*';
      if (next === active) return;
      active = next;

      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.tag === active));
      }

      apply();
      if (push) {
        history.pushState(null, '', active === '*' ? '/tags' : `/tags#${active}`);
      }
    };

    root.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (chip) select(chip.dataset.tag ?? '*', true);
    });

    window.addEventListener('popstate', () => select(hashTag() || '*', false));
    window.addEventListener('hashchange', () => select(hashTag() || '*', false));

    select(hashTag() || '*', false);
  }
</script>
