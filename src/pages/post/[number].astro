---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GithubMarkIcon from '../../assets/icons/github-mark.svg';
import UndoIcon from '../../assets/icons/undo.svg';
import { getPosts } from '../../lib/posts';
import { fullDate } from '../../lib/dates';
import type { Post } from '../../lib/posts';
import { site } from '../../lib/site';

interface Props {
  post: Post;
  previous: Post | null;
  nextPost: Post | null;
}

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { number: String(post.number) },
    props: {
      post,
      previous: posts[index + 1] ?? null,
      nextPost: posts[index - 1] ?? null,
    },
  }));
}

const { post, previous, nextPost } = Astro.props as Props;
const publishedTime = new Date(post.created.getTime() - site.timezone * 3600 * 1000).toISOString();
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  article={{ publishedTime }}
  hideHeader
  hideFooter
>
  <article class="relative">
    <a
      href="/"
      class="intent-dim mb-6 sm:mb-8 inline-flex items-center gap-2 whitespace-nowrap text-[14px] text-muted transition-colors hover:text-fg lg:absolute lg:top-0 lg:right-full lg:mb-0 lg:mr-16 lg:h-8"
    >
      <UndoIcon class="size-4" aria-hidden="true" focusable="false" />
      返回
    </a>

    <header class="intent-zone mb-8 sm:mb-12">
      <h1 class="text-[24px] leading-8 text-fg text-balance">{post.title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-2 text-[14px] text-muted">
        {
          post.tags.map((tag) => (
            <>
              <a
                href={`/tags#${tag.slug}`}
                class="post-tag transition-colors"
                style={`--tag: #${tag.color ?? '999999'}`}
              >
                {tag.name}
              </a>
              <span aria-hidden="true" class="text-faint">·</span>
            </>
          ))
        }
        <time datetime={post.date}>{fullDate(post.created)}</time>
        <span class="intent-hidden inline-flex items-center gap-x-2">
          <span aria-hidden="true" class="text-faint">·</span>
          <a
            href={post.source}
            class="inline-flex size-6 items-center justify-center rounded-lg text-muted transition-colors hover:text-fg"
            aria-label="在 GitHub 上查看 issue"
            title="在 GitHub 上查看 issue"
            target="_blank"
            rel="noopener"
          >
            <GithubMarkIcon class="size-4" aria-hidden="true" focusable="false" />
          </a>
        </span>
      </div>
    </header>

    <div class="prose" set:html={post.html} />

    {
      (previous || nextPost) && (
        <nav
          class="mt-14 grid gap-6 sm:mt-24 sm:grid-cols-2 sm:gap-8"
          aria-label="文章导航"
        >
          {previous && (
            <a href={previous.url} class="group flex flex-col gap-2">
              <span class="text-[13px] text-faint">Previous</span>
              <span class="text-[16px] leading-7 text-fg transition-colors group-hover:text-accent">
                {previous.title}
              </span>
            </a>
          )}
          {nextPost && (
            <a
              href={nextPost.url}
              class="group flex flex-col gap-2 sm:col-start-2 sm:items-end sm:text-right"
            >
              <span class="text-[13px] text-faint">Next</span>
              <span class="text-[16px] leading-7 text-fg transition-colors group-hover:text-accent">
                {nextPost.title}
              </span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
