---
import type { Post } from '../lib/posts';
import { listDate } from '../lib/dates';

interface Props {
  post: Post;
  showPinned?: boolean;
}

const { post, showPinned = false } = Astro.props;
---

<a href={post.url} class="group flex items-baseline justify-between gap-6 py-1 leading-7 sm:py-2">
  <span class="text-[17px] text-fg transition-colors group-hover:text-accent">
    {post.title}
    {showPinned && post.pinned && <span class="ml-1 text-[0.72em] align-[0.12em] text-accent">✳</span>}
  </span>
  <time datetime={post.date} class="shrink-0 whitespace-nowrap text-[14px] text-faint tabular-nums transition-colors group-hover:text-muted">
    {listDate(post.created)}
  </time>
</a>
