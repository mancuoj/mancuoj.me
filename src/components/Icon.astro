  x: '<path d="M4 4h4.267l11.733 16H20"/><path d="M4 20l6.768-6.768m2.46-2.46L20 4"/>',
  external: '<path d="M7 17 17 7"/><path d="M7 7h10v10"/>',
  rss: '<path d="M4 19a1 1 0 1 0 2 0a1 1 0 1 0-2 0"/><path d="M4 4a16 16 0 0 1 16 16"/><path d="M4 11a9 9 0 0 1 9 9"/>',
  mail: '<path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7"/><path d="M3 7l9 6l9-6"/>',
  bilibili:
    '<path d="M3 10a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v6a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-6"/><path d="M8 3l2 3"/><path d="M16 3l-2 3"/><path d="M9 13v-2"/><path d="M15 11v2"/>',
