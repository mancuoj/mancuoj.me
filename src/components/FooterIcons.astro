---
import { site } from '../lib/site';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const isExternal = (url: string) => url.startsWith('http');
---

<footer class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-4">
  <nav class="flex flex-wrap items-center gap-x-3.5 gap-y-3" aria-label="链接">
    {
      site.social.map((item) => (
        <a
          href={item.url}
          class="text-muted transition-colors hover:text-fg"
          aria-label={item.label}
          title={item.label}
          {...(isExternal(item.url) ? { target: '_blank', rel: 'noopener' } : {})}
        >
          <Icon name={item.icon} class="size-5" />
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
  <span class="ml-auto shrink-0 text-[13.5px] text-faint">© {new Date().getFullYear()} {site.title}</span>
</footer>
