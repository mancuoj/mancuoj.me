---
import { site } from '../lib/site';
import { localDate, yearOf } from '../lib/dates';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const isExternal = (url: string) => url.startsWith('http');
const currentYear = yearOf(localDate(new Date().toISOString(), site.timezone));
---

<footer class="intent-zone mt-12 flex flex-wrap items-center justify-between gap-4 sm:mt-24">
  <div class="intent-dim flex flex-wrap items-center gap-x-3 gap-y-3">
    <nav class="flex flex-wrap items-center gap-x-3 gap-y-3" aria-label="链接">
      {
        site.social.map((item) => (
          <a
            href={item.url}
            class="inline-flex size-6 items-center justify-center rounded-lg text-muted transition-colors hover:text-fg"
            aria-label={item.label}
            title={item.label}
            {...(isExternal(item.url) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <Icon name={item.icon} class="size-6" />
          </a>
        ))
      }
    </nav>
    <ThemeToggle />
  </div>
  <span class="ml-auto shrink-0 text-[14px] text-faint">© {currentYear} {site.title}</span>
</footer>
