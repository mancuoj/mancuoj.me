---
import { site } from '../lib/site';
import { localDate, yearOf } from '../lib/dates';
import Icon from './Icon.astro';

const isExternal = (url: string) => url.startsWith('http');
const currentYear = yearOf(localDate(new Date().toISOString(), site.timezone));
---

<footer class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-5">
  <nav class="flex flex-wrap items-center gap-x-3.5 gap-y-3" aria-label="链接">
    {
      site.social.map((item) => (
        <a
          href={item.url}
          class="text-faint transition-colors hover:text-fg"
          aria-label={item.label}
          title={item.label}
          {...(isExternal(item.url) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <Icon name={item.icon} class="size-4" />
        </a>
      ))
    }
    {
      site.showRss && (
        <a
          href="/rss.xml"
          class="text-faint transition-colors hover:text-fg"
          aria-label="RSS"
          title="RSS"
        >
          <Icon name="rss" class="size-4" />
        </a>
      )
    }
  </nav>
  <span class="ml-auto shrink-0 text-[13px] text-faint">© {currentYear} {site.title}</span>
</footer>
