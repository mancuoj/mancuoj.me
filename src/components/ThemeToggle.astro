<button
  type="button"
  id="theme-switch"
  class="text-muted transition-colors hover:text-fg"
  aria-label="切换主题"
  title="切换主题"
>
  <svg
    class="theme-sun size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0"></path>
    <path d="M3 12h1m8-9v1m8 8h1m-9 8v1m-6.4-15.4l.7.7m12.1-.7l-.7.7m0 11.4l.7.7m-12.1-.7l-.7.7"></path>
  </svg>
  <svg
    class="theme-moon size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1-8.313-12.454l0 .008"></path>
  </svg>
  <span class="sr-only">切换主题</span>
</button>

<script>
  const root = document.documentElement;
  const switcher = document.getElementById('theme-switch');

  function sync() {
    const dark = root.dataset.theme === 'dark';
    const text = dark ? '切换到浅色' : '切换到深色';
    switcher?.setAttribute('aria-label', text);
    switcher?.setAttribute('title', text);
    const sr = switcher?.querySelector('.sr-only');
    if (sr) sr.textContent = text;
  }

  switcher?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });

  sync();
</script>
