---
import MoonIcon from '../assets/icons/moon.svg';
import SunIcon from '../assets/icons/sun.svg';
---

<button
  type="button"
  id="theme-switch"
  class="inline-flex size-6 cursor-pointer items-center justify-center rounded-lg text-muted transition-colors hover:text-fg"
  aria-label="切换主题"
  title="切换主题"
>
  <SunIcon class="theme-sun size-6" aria-hidden="true" focusable="false" />
  <MoonIcon class="theme-moon size-6" aria-hidden="true" focusable="false" />
  <span class="sr-only">切换主题</span>
</button>

<script>
  const root = document.documentElement;
  const switcher = document.getElementById('theme-switch');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const media = window.matchMedia?.('(prefers-color-scheme: dark)');

  function apply(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    themeColor?.setAttribute('content', theme === 'dark' ? '#111111' : '#fafafa');
    const text = theme === 'dark' ? '切换到浅色' : '切换到深色';
    switcher?.setAttribute('aria-label', text);
    switcher?.setAttribute('title', text);
    const sr = switcher?.querySelector('.sr-only');
    if (sr) sr.textContent = text;
  }

  switcher?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', next);
    } catch {}
    apply(next);
  });

  media?.addEventListener('change', (event) => {
    try {
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || stored === 'light') return;
    } catch {}
    apply(event.matches ? 'dark' : 'light');
  });

  apply(root.dataset.theme === 'dark' ? 'dark' : 'light');
</script>
