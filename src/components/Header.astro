---
import { site } from '../lib/site';
---

<header class="flex items-center justify-between">
  <a href="/" class="flex items-center gap-2.5">
    <img src={site.avatar} alt="" width="24" height="24" class="size-6 rounded-full" />
    <span class="text-sm font-medium">{site.title}</span>
  </a>
  <nav class="flex items-center gap-5 text-sm text-muted" aria-label="主导航">
    <a href="/tags/" class="transition-colors hover:text-fg">标签</a>
  </nav>
</header>
