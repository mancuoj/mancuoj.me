---
import { site } from '../lib/site';

const path = Astro.url.pathname.replace(/\.html$/, '');
const onTags = path === '/tags';
---

<header class="flex items-center justify-between">
  <a href="/" class="flex items-center gap-2.5">
    <img src="/avatar.png" alt="" width="24" height="24" class="size-6 rounded-full" />
    <span class="text-sm font-medium">{site.title}</span>
  </a>
  <nav class="flex items-center gap-5 text-sm text-muted" aria-label="主导航">
    <a
      href="/tags"
      class:list={['transition-colors hover:text-fg', onTags && 'text-fg']}
      aria-current={onTags ? 'page' : undefined}
    >
      标签
    </a>
    <a href="/rss.xml" class="transition-colors hover:text-fg">RSS</a>
  </nav>
</header>
