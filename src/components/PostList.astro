---
import type { YearGroup } from '../lib/posts';
import PostRow from './PostRow.astro';

interface Props {
  groups: YearGroup[];
}

const { groups } = Astro.props;
---

{
  groups.length > 0 && (
    <section class="mt-10 space-y-10 sm:mt-24 sm:space-y-16" aria-label="文章">
      {groups.map((group) => (
        <section class="grid gap-2 sm:grid-cols-[4rem_minmax(0,1fr)] sm:gap-x-8">
          <h2 class="text-[14px] leading-7 text-faint tabular-nums sm:sticky sm:top-6 sm:self-start sm:py-2">
            {group.year}
          </h2>
          <ol class="min-w-0">
            {group.posts.map((post) => (
              <li>
                <PostRow post={post} showPinned />
              </li>
            ))}
          </ol>
        </section>
      ))}
    </section>
  )
}
