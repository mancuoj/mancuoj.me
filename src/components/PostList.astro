---
import type { YearGroup } from '../lib/posts';
import PostRow from './PostRow.astro';

interface Props {
  groups: YearGroup[];
}

const { groups } = Astro.props;
---

{
  groups.length > 0 && (
    <section class="mt-11 space-y-10" aria-label="文章">
      {groups.map((group) => (
        <section class="relative">
          <h2 class="mb-2 text-[13px] text-faint tabular-nums">
            {group.year}
          </h2>
          <ol class="min-w-0">
            {group.posts.map((post) => (
              <li>
                <PostRow post={post} showPinned />
              </li>
            ))}
          </ol>
        </section>
      ))}
    </section>
  )
}
