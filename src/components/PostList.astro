---
import type { YearGroup } from '../lib/posts';
import { listDate } from '../lib/dates';

interface Props {
  groups: YearGroup[];
}

const { groups } = Astro.props;
---

<section class="mt-16 space-y-10" aria-label="文章">
  {
    groups.map((group) => (
      <section class="grid gap-3 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-6">
        <h2 class="text-sm text-muted tabular-nums sm:sticky sm:top-4 sm:self-start sm:leading-7">
          {group.year}
        </h2>
        <ol class="min-w-0">
          {group.posts.map((post) => (
            <li>
              <a
                href={post.url}
                class="group flex items-baseline justify-between gap-6 py-1 leading-6"
              >
                <span class="text-[15px] text-fg transition-colors group-hover:text-muted">
                  {post.title}
                  {post.pinned && <span class="ml-1 text-[0.72em] align-[0.12em]">✳</span>}
                </span>
                <time datetime={post.date} class="shrink-0 whitespace-nowrap text-[13px] text-faint tabular-nums">
                  {listDate(post.created)}
                </time>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</section>
