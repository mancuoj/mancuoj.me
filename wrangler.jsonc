{
  "name": "mancuoj-me",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "mancuoj.me", "custom_domain": true },
    { "pattern": "www.mancuoj.me", "custom_domain": true }
  ]
}
